{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "livekit-testing-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Testing framework patterns for LiveKit WebRTC applications with TestContainers, Selenium, and Cucumber",
            "promptTriggers": {
                "keywords": [
                    "livekit",
                    "container",
                    "testcontainers",
                    "page object",
                    "webdriver",
                    "selenium",
                    "webrtc",
                    "state manager",
                    "token",
                    "permission",
                    "room",
                    "egress",
                    "minio",
                    "redis",
                    "browser automation",
                    "vnc",
                    "recording",
                    "docker"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(container|page.*?object|state.*?manager)",
                    "(test|automate).*?(webrtc|browser|livekit|room)",
                    "(how to|best practice).*?(container|selenium|testcontainers|page object)",
                    "(start|stop|manage).*?container",
                    "(create|generate).*?token"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "src/main/java/**/*.java",
                    "**/container/**/*.java",
                    "**/page/**/*.java",
                    "**/state/**/*.java",
                    "**/config/**/*.java",
                    "**/util/**/*.java"
                ],
                "pathExclusions": [
                    "**/test/**/*.java",
                    "**/*Test.java",
                    "**/*Tests.java"
                ],
                "contentPatterns": [
                    "GenericContainer",
                    "TestContainers",
                    "WebDriver",
                    "ChromeDriver",
                    "LiveKitContainer",
                    "StateManager",
                    "AccessToken",
                    "VideoGrant"
                ]
            }
        },
        "bdd-tester": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Cucumber/Gherkin BDD testing patterns with step definitions and scenario management",
            "promptTriggers": {
                "keywords": [
                    "cucumber",
                    "gherkin",
                    "bdd",
                    "feature file",
                    "step definition",
                    "scenario",
                    "scenario outline",
                    "given when then",
                    "before hook",
                    "after hook",
                    "background",
                    "examples",
                    "data table",
                    "tags"
                ],
                "intentPatterns": [
                    "(write|create|add).*?(feature|scenario|step)",
                    "(test|verify|validate).*?(behavior|scenario|feature)",
                    "(how to|how do I).*?(cucumber|gherkin|bdd)",
                    "(run|execute).*?(scenario|feature|test)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "src/test/resources/features/**/*.feature",
                    "**/bdd/**/*.java",
                    "**/steps/**/*.java",
                    "**/*Steps.java",
                    "**/CucumberHooks.java"
                ],
                "contentPatterns": [
                    "@Given",
                    "@When",
                    "@Then",
                    "@Before",
                    "@After",
                    "Feature:",
                    "Scenario:",
                    "Scenario Outline:",
                    "io.cucumber"
                ]
            }
        },
        "git-workflow": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Git workflow standards for branch management, commits, and pre-commit testing",
            "promptTriggers": {
                "keywords": [
                    "git",
                    "commit",
                    "branch",
                    "merge",
                    "pull request",
                    "PR",
                    "push",
                    "checkout",
                    "rebase",
                    "git workflow",
                    "commit message",
                    "feature branch",
                    "start task",
                    "start story",
                    "new feature"
                ],
                "intentPatterns": [
                    "(create|start|make).*?(branch|feature|task)",
                    "(commit|push|merge).*?(change|code)",
                    "(how to|best practice).*?(commit|branch|git)",
                    "(finish|complete|end).*?(task|story|feature)"
                ]
            }
        },
        "error-tracking": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Logging, debugging, and error tracking patterns for test frameworks",
            "promptTriggers": {
                "keywords": [
                    "error handling",
                    "exception",
                    "logging",
                    "error tracking",
                    "debug",
                    "debugging",
                    "trace",
                    "log",
                    "Slf4j",
                    "logback",
                    "stack trace",
                    "test failure"
                ],
                "intentPatterns": [
                    "(add|create|implement|setup).*?(logging|debug|error handling)",
                    "(fix|handle|catch).*?(error|exception)",
                    "(how to|best practice).*?(log|debug|trace|error)",
                    "(debug|troubleshoot|diagnose).*?(test|container|browser)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/*.java",
                    "**/logback*.xml",
                    "**/log4j*.xml"
                ],
                "contentPatterns": [
                    "@Slf4j",
                    "log\\.(error|warn|info|debug|trace)",
                    "Logger",
                    "LoggerFactory"
                ]
            }
        },
        "product-owner": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Product ownership patterns for feature definition, user stories, acceptance criteria, and task breakdown",
            "promptTriggers": {
                "keywords": [
                    "product owner",
                    "user story",
                    "user stories",
                    "acceptance criteria",
                    "feature definition",
                    "epic",
                    "requirements",
                    "task breakdown",
                    "split task",
                    "break down",
                    "definition of done",
                    "scope",
                    "in scope",
                    "out of scope",
                    "given when then",
                    "as a user",
                    "so that",
                    "feature spec",
                    "feature documentation",
                    "requirements doc",
                    "story points",
                    "sprint planning",
                    "backlog"
                ],
                "intentPatterns": [
                    "(define|create|write).*?(feature|requirement|story|epic)",
                    "(break|split).*?(down|into|task|story)",
                    "(acceptance|done).*?criteria",
                    "(organize|structure).*?(feature|requirement).*?doc",
                    "(plan|scope).*?(feature|epic|work)",
                    "how (to|do I).*?(write|define).*?(story|requirement|feature)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "**/docs/features/**/*.md",
                    "**/documentation/features/**/*.md",
                    "**/requirements/**/*.md",
                    "**/*requirements*.md",
                    "**/*stories*.md",
                    "**/*epic*.md"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "pathPatterns": "Adjust to match your project structure",
            "keywords": "Add domain-specific terms relevant to your project",
            "intentPatterns": "Use regex for flexible user intent matching"
        }
    }
}
